<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_doctorplagio_document_list" model="ir.ui.view">
        <field name="name">doctorplagio.document.list</field>
        <field name="model">doctorplagio.document</field>
        <field name="arch" type="xml">
            <list string="Documentos">
                <field name="name"/>
                <field name="file_name"/>
                <field name="state"/>
                <field name="plagiarism_percentage"/>
                <field name="copy_paste_percentage"/>
                <field name="copy_paste_evidence_count"/>
                <field name="ai_coverage_percentage"/>
            </list>
        </field>
    </record>

    <record id="view_doctorplagio_document_form" model="ir.ui.view">
        <field name="name">doctorplagio.document.form</field>
        <field name="model">doctorplagio.document</field>
        <field name="arch" type="xml">
            <form string="Documento DoctorPlagio">
                <header>
                    <button name="action_analyze"
                            type="object"
                            string="Analizar documento"
                            class="oe_highlight"
                            invisible="state == 'analyzing' or not file_data"/>
                    <button name="action_download_report"
                            type="object"
                            string="Descargar informe PDF"
                            class="btn-secondary"
                            invisible="state != 'done' or not results_json"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,analyzing,done,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Documento">
                            <field name="name"/>
                            <field name="file_name" invisible="not file_name"
                                   readonly="state == 'done'"/>
                            <field name="file_data" filename="file_name"
                                   readonly="state == 'done'"/>
                        </group>
                        <group string="Estado del servicio">
                            <field name="backend_document_id" invisible="not backend_document_id"/>
                            <field name="backend_version_id" invisible="not backend_version_id"/>
                            <field name="analysis_error" readonly="1"
                                   invisible="not analysis_error"/>
                            <field name="analysis_note" readonly="1"
                                   invisible="not analysis_note"/>
                        </group>
                    </group>

                    <group string="Resumen de coincidencias">
                        <group>
                            <field name="plagiarism_percentage" readonly="1"/>
                            <field name="copy_paste_percentage" readonly="1"/>
                            <field name="copy_paste_message" readonly="1"
                                   invisible="not copy_paste_message"/>
                        </group>
                        <group>
                            <field name="copy_paste_sources_count" readonly="1"/>
                            <field name="copy_paste_evidence_count" readonly="1"/>
                        </group>
                    </group>

                    <group string="Análisis de IA">
                        <group>
                            <field name="ai_analysis_available" readonly="1"/>
                            <field name="ai_result_label" readonly="1"
                                   invisible="not ai_result_label"/>
                        </group>
                        <group>
                            <field name="ai_score_percentage" readonly="1"/>
                            <field name="ai_coverage_percentage" readonly="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert"
                         invisible="state != 'done'">
                        Los porcentajes de similitud general y Copy/Paste son métricas diferentes.
                        La cobertura de IA indica cuánto contenido pudo evaluarse; no es una
                        prueba concluyente de autoría.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doctorplagio_documents" model="ir.actions.act_window">
        <field name="name">Documentos</field>
        <field name="res_model">doctorplagio.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_doctorplagio_root" name="DoctorPlagio" sequence="10"/>
    <menuitem id="menu_doctorplagio_documents"
              name="Documentos"
              parent="menu_doctorplagio_root"
              action="action_doctorplagio_documents"
              sequence="10"/>
</odoo>
